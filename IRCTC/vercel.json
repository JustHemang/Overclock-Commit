{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/search", "dest": "/search.html" },
    { "src": "/tracking", "dest": "/schedule.html" },
    { "src": "/pnr", "dest": "/pnr.html" },
    { "src": "/bookings", "dest": "/bookings.html" },
    { "src": "/checkout", "dest": "/checkout.html" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/profile", "dest": "/profile.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
